cabal-version:      2.4
name:               contextual-bandit
version:            0.1.0.0
synopsis:           Contextual bandit interface, ported from a Z3-checked spec (z3/)
build-type:         Simple

library
    exposed-modules:  ContextualBandit, Models, Video, Pi
    hs-source-dirs:   src
    build-depends:    base >=4 && <5, containers
    default-language: Haskell2010
    ghc-options:      -Wall

executable examples
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5, containers, contextual-bandit
    default-language: Haskell2010
    ghc-options:      -Wall -O2

executable video
    main-is:          Video.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5, containers, contextual-bandit
    default-language: Haskell2010
    ghc-options:      -Wall -O2
