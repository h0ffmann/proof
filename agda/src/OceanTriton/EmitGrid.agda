{-# OPTIONS --safe --without-K #-}

-- The Triton printer for the 2-D kernels of `OceanTriton.Grid` and the programs of
-- `OceanTriton.Space`. Like `OceanTriton.Emit`, this file is trusted: nothing proves that the
-- printed Python means what `eval2` means. Lane i is the cell x = i % nx, y = i // nx, stored at
-- y * nx + x, and every case maps to one Triton expression:
--
--     cell a      a[i]
--     west a      a[y * nx + xw], xw = x - 1, and nx - 1 where x = 0
--     south a     a[ys * nx + x], ys = y - 1, and ny - 1 where y = 0
--     giny a o    a[i - nx], a[i], a[i + nx] (c = y - 1, y, y + 1) where 1 <= c and c + 1 < ny,
--                 else 0
--     the rest    as in `OceanTriton.Emit`
--
-- A program prints as a row of PROGRAMS: its buffers, its parameters, and its launches in order,
-- each the kernel, the buffers it reads, the parameters it takes and the buffer it writes. A
-- host that runs them in that order, each into a fresh buffer, computes `steps`.
module OceanTriton.EmitGrid where

open import Data.Fin using (Fin)
open import Data.List as L using (List; []; _∷_; concat)
open import Data.String using (String; _++_; unlines)
open import Data.Vec using (Vec; lookup; toList)
import Data.Vec as V

open import OceanTriton.Emit using (pyLit; commas; quoted; tuple)
open import OceanTriton.Grid

module _ {na ns} (as : Vec String na) (ss : Vec String ns) where

  private
    ld : Fin na → String → String → String
    ld a idx mask = "tl.load(" ++ lookup as a ++ "_ptr + " ++ idx ++ ", mask=" ++ mask ++ ", other=0.0)"

  py2 : Expr2 na ns → String
  py2 (cell a)       = ld a "i" "m"
  py2 (west a)       = ld a "y * nx + tl.where(x > 0, x - 1, nx - 1)" "m"
  py2 (south a)      = ld a "tl.where(y > 0, y - 1, ny - 1) * nx + x" "m"
  py2 (giny a left)  = "tl.where((y >= 2) & (y < ny), " ++ ld a "i - nx" "m & (y >= 2)" ++ ", 0.0)"
  py2 (giny a here)  = "tl.where((y >= 1) & (y + 1 < ny), " ++ ld a "i" "m" ++ ", 0.0)"
  py2 (giny a right) = "tl.where(y + 2 < ny, " ++ ld a "i + nx" "m & (y + 2 < ny)" ++ ", 0.0)"
  py2 (par s)        = lookup ss s
  py2 (con q)        = pyLit q
  py2 (p ⊕ q)        = "(" ++ py2 p ++ " + " ++ py2 q ++ ")"
  py2 (p ⊖ q)        = "(" ++ py2 p ++ " - " ++ py2 q ++ ")"
  py2 (p ⊗ q)        = "(" ++ py2 p ++ " * " ++ py2 q ++ ")"
  py2 (p ⊘ q)        = "_div0(" ++ py2 p ++ ", " ++ py2 q ++ ")"
  py2 (neg p)        = "(-" ++ py2 p ++ ")"
  py2 (max p q)      = "tl.maximum(" ++ py2 p ++ ", " ++ py2 q ++ ")"
  py2 (min p q)      = "tl.minimum(" ++ py2 p ++ ", " ++ py2 q ++ ")"

function2 : Kernel2 → List String
function2 K =
  "@triton.jit" ∷
  ("def " ++ name K ++ "(" ++ ps ++ "):") ∷
  ("    \"\"\"" ++ doc K ++ ".\"\"\"") ∷
  "    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)" ∷
  "    m = i < nx * ny" ∷
  "    x = i % nx" ∷
  "    y = i // nx" ∷
  ("    tl.store(out_ptr + i, " ++ py2 (arrays K) (scalars K) (body K) ++ ", mask=m)") ∷
  "" ∷ "" ∷ []
  where
  ps = commas (L.map (_++ "_ptr") (toList (arrays K)) L.++ toList (scalars K)
               L.++ ("out_ptr" ∷ "nx" ∷ "ny" ∷ "BLOCK: tl.constexpr" ∷ []))

private
  names : ∀ {n m} → Vec String n → Vec (Fin n) m → String
  names bs is = "(" ++ tuple (toList (V.map (lookup bs) is)) ++ ")"

  launchRow : ∀ {nb np} → Vec String nb → Vec String np → Launch nb np → String
  launchRow bs ps L = "        (" ++ name (kernel L) ++ ", " ++ names bs (ins L) ++ ", " ++ names ps (scs L)
                      ++ ", " ++ quoted (lookup bs (out L)) ++ "),"

programRows : Program → List String
programRows P =
  ("    " ++ quoted (name P) ++ ": ((" ++ tuple (toList (buffers P)) ++ "), (" ++ tuple (toList (params P)) ++ "), (") ∷
  L.map (launchRow (buffers P) (params P)) (launches P) L.++
  (("    ), " ++ quoted (lookup (buffers P) (result P)) ++ "),") ∷ [])

-- The whole Python module.
gridModule : List Kernel2 → List Program → String
gridModule ks ps = unlines (
  "# Generated by tools/ocean-triton/ from agda/src/OceanTriton/Space.agda. Do not edit:" ∷
  "# change the Agda and run `just ocean-triton`." ∷
  "\"\"\"The 2-D kernels and the launch programs of agda/src/OceanTriton/Space.agda.\"\"\"" ∷
  "" ∷
  "import triton" ∷
  "import triton.language as tl" ∷
  "" ∷
  "" ∷
  "@triton.jit" ∷
  "def _div0(x, y):" ∷
  "    \"\"\"x / y, and 0 where y = 0 (the total division of OceanWaves.Order).\"\"\"" ∷
  "    nz = y != 0.0" ∷
  "    return tl.where(nz, x / tl.where(nz, y, 1.0), 0.0)" ∷
  "" ∷
  "" ∷
  concat (L.map function2 ks) L.++
  ("# name: (buffers, parameters, launches as (kernel, reads, parameters, writes), result)" ∷
   "PROGRAMS = {" ∷ concat (L.map programRows ps) L.++ ("}" ∷ [])))
